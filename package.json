{
  "name": "lowcode-carousel-studio",
  "productName": "轮播视频工作台",
  "version": "1.1.0",
  "private": true,
  "description": "低代码图片轮播视频编辑与导出工具",
  "author": "Local Studio",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run build && node server.js",
    "dev": "concurrently -k \"node server.js\" \"vite --host 0.0.0.0 --port 5173\"",
    "desktop": "npm run build && electron .",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:win": "npm run build && electron-builder --win",
    "pack:win:zip": "npm run build && electron-builder --win zip --x64",
    "android:add": "npm run build && cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check": "npm run lint && npm run build && node --check server.js && node --check electron/main.cjs && node --check electron/preload.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/share": "^7.0.4",
    "animate.css": "^4.1.1",
    "animejs": "^4.5.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.4",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.1"
  }
}
